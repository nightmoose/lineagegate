# FalkorDB connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
LINEAGEGATE_GRAPH=acme

# Optional LLM for `lineagegate ask` (any one of these; OpenAI-compatible APIs).
# Without a key, `ask` falls back to a deterministic offline tool router.
# XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_BASE_URL=          # custom OpenAI-compatible endpoint (with LLM_API_KEY)
# LLM_API_KEY=
# LLM_MODEL=             # override default model for the chosen provider
